// Obfuscated string decryption (simple XOR for complication)
std::string DecryptString(const char* encrypted, size_t len, BYTE key) {
    std::string decrypted;
    for (size_t i = 0; i < len; ++i) {
        decrypted += encrypted[i] ^ key;
    }
    return decrypted;
}

// VEH Handler: Complicated with context checks
LONG WINAPI VectoredExceptionHandler(EXCEPTION_POINTERS* ExceptionInfo) {
    DWORD exceptionCode = ExceptionInfo->ExceptionRecord->ExceptionCode;
    
    // Check for expected exceptions; debuggers may alter code or context
    if (exceptionCode == 0xC0000008 || exceptionCode == 0xC0000235) {
        // Advanced check: Verify context (e.g., EIP/RIP) isn't tampered
        #ifdef _WIN64
        if (ExceptionInfo->ContextRecord->Rip == 0) { // Debugger might zero it
            return EXCEPTION_CONTINUE_EXECUTION; // Pretend normal, but flag later
        }
        #else
        if (ExceptionInfo->ContextRecord->Eip == 0) {
            return EXCEPTION_CONTINUE_EXECUTION;
        }
        #endif
        
        // If exception matches but context is off, assume debugger
        std::cout << "Suspicious exception context detected.\n";
        return EXCEPTION_EXECUTE_HANDLER; // Handle and detect
    }
    
    return EXCEPTION_CONTINUE_SEARCH; // Pass to next handler
}

bool CheckDebuggerWithComplicatedCloseHandle() {
    bool isDebugged = false;
    
    // Install VEH for first-chance handling
    PVOID vehHandle = AddVectoredExceptionHandler(1, VectoredExceptionHandler);
    if (!vehHandle) return false; // Fail-safe
    
    // Dynamic invalid handle computation (obfuscated)
    HANDLE invalidHandle;
    __asm {
        mov eax, 0xDEADBEEF  // Base value
        xor eax, 0xCAFEBABE  // Obfuscate with XOR
        mov invalidHandle, eax
    }
    
    // Create protected handle: Open dummy file with obfuscated path
    const char encryptedPath[] = {0x7D, 0x6A, 0x7D, 0x7B, 0x6A, 0x7D, 0x2E, 0x7D, 0x7F, 0x7D}; // XOR-encrypted "dummy.txt"
    std::string filePath = DecryptString(encryptedPath, sizeof(encryptedPath), 0x10);
    HANDLE protectedHandle = CreateFileA(filePath.c_str(), GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    
    if (protectedHandle != INVALID_HANDLE_VALUE) {
        // Protect from closing
        DWORD flags = HANDLE_FLAG_PROTECT_FROM_CLOSE;
        SetHandleInformation(protectedHandle, flags, flags);
        
        // Trigger on protected handle
        __try {
            CloseHandle(protectedHandle);
        } __except (EXCEPTION_EXECUTE_HANDLER) {
            if (GetExceptionCode() != 0xC0000235) {
                isDebugged = true; // Code altered by debugger
            }
        }
    }
    
    // Trigger on invalid handle
    __try {
        CloseHandle(invalidHandle);
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        if (GetExceptionCode() != 0xC0000008) {
            isDebugged = true;
        }
    }
    
    // Optional: Reset debug registers on current thread for added complication
    HANDLE hThread = GetCurrentThread();
    CONTEXT ctx = {0};
    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
    GetThreadContext(hThread, &ctx);
    ctx.Dr0 = ctx.Dr1 = ctx.Dr2 = ctx.Dr3 = 0;
    ctx.Dr7 &= ~(0x1 | 0x4 | 0x10 | 0x40); // Clear breakpoint enables
    SetThreadContext(hThread, &ctx);
    
    // Cleanup
    RemoveVectoredExceptionHandler(vehHandle);
    if (protectedHandle != INVALID_HANDLE_VALUE) {
        // Force close if possible (ignore errors)
        CloseHandle(protectedHandle);
        DeleteFileA(filePath.c_str()); // Clean dummy file
    }
    
    return isDebugged;
}

